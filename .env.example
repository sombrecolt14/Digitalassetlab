# Copy to .env for local runs; on Netlify these live in
# Site configuration → Environment variables. Never commit real values.

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys → Generate Live Key.
# The secret is shown exactly once at generation; regenerate if it is lost.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → Add New Webhook.
#   URL    : https://digitalassetlab.in/api/razorpay-webhook
#   Events : payment.captured
# The secret is whatever you type into that form — paste the same string here.
# This is the delivery backstop: it still emails the files if the buyer closes
# their browser before client-side verification runs.
RAZORPAY_WEBHOOK_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
SITE_URL=https://digitalassetlab.in

# ── Delivery email (SMTP) ───────────────────────────────────────────────────
# Without these the payment still succeeds, but no download email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Digital Asset Lab

# ── Download links, one per product key in server.cjs ────────────────────────
# Left empty, the buyer is told their link follows within a few hours.
ARCH_DOWNLOAD_URL=
PRESENTATION_DOWNLOAD_URL=
DRAFTING_DOWNLOAD_URL=
CONTRACTS_DOWNLOAD_URL=
